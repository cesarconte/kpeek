#
# Dolphin service menu: adds Quick Look to the context menu of every file and folder.
[Desktop Entry]
Type=Service
MimeType=all/all;
X-KDE-Protocols=file,trash,KIO
Actions=peek;

[Desktop Action peek]
Name=Quick Look
Name[es]=Quick Look (Vista rápida)
Comment=Quickly preview the selected files
Comment[es]=Previsualización instantánea al estilo macOS Golden Gate
Icon=view-preview
Exec=kpeek %U
